{
  "name": "paperlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:404",
    "preview": "vite preview",
    "test": "vitest run",
    "evidence": "node scripts/evidence.mjs",
    "build:404": "node $HOUSE_DIR/house/2.0.1/tools/house-sync.mjs --404 dist/404.html --room paperlab",
    "house:sync": "node $HOUSE_DIR/house/2.0.1/tools/house-sync.mjs --room paperlab index.html",
    "house:check": "node $HOUSE_DIR/house/2.0.1/tools/house-sync.mjs --check --room paperlab index.html"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
